# Shared configuration for the scripts in this repo.
# Copy to .env and fill in real values: cp .env.example .env
# The backup scripts also accept ENV_FILE=/path/to/.env to use another file.

# ---------------------------------------------------------------------------
# systemd-service-starter.sh
# ---------------------------------------------------------------------------
SERVICES=(
    "nginx"
    "postgresql"
)

# ---------------------------------------------------------------------------
# docker-install.sh
# ---------------------------------------------------------------------------
GPG_URL=https://download.docker.com/linux/debian/gpg
DOCKER_SOURCE_LIST_URL=https://download.docker.com/linux/debian
DOCKER_SOURCE_LIST_COMPONENT=stable
DEBIAN_CODENAME="$(. /etc/os-release 2>/dev/null && printf '%s' "$VERSION_CODENAME")"
ARCH="$(dpkg --print-architecture 2>/dev/null)"

# ---------------------------------------------------------------------------
# backup-system-postgres-db.sh / backup-docker-postgres-db.sh
# ---------------------------------------------------------------------------
# Required
POSTGRES_BACKUP_DIR=/srv/backups/postgres
POSTGRES_DATABASES="app_db another_db"          # space-separated
POSTGRES_SSH_TARGET=backup@db.example.com
POSTGRES_SSH_KEY_PATH=/root/.ssh/id_ed25519_backup
POSTGRES_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
POSTGRES_COMPOSE_DIR=/opt/app                   # docker variant only

# Optional (defaults shown)
# POSTGRES_OLD_BACKUP_DIR="$POSTGRES_BACKUP_DIR/old-backups"
# POSTGRES_OS_USER=postgres                     # system variant only
# POSTGRES_DB_USER=postgres                     # docker variant defaults to waggy
# POSTGRES_COMPOSE_FILE=compose.yml             # docker variant only
# POSTGRES_COMPOSE_SERVICE=db                   # docker variant only
# POSTGRES_DUMP_FORMAT=c
# POSTGRES_DUMP_COMPRESSION=4
# POSTGRES_BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# jira-backup.sh
# ---------------------------------------------------------------------------
JIRA_SSH_TARGET=backup@jira.example.com
JIRA_SSH_KEY=/root/.ssh/id_ed25519_backup
JIRA_APP_CONTAINER=jira
JIRA_DB_CONTAINER=jira-db
JIRA_DATA_PATH=/var/atlassian/application-data/jira
JIRA_COMPOSE_DIR=/opt/jira
JIRA_BACKUP_DIR=/srv/backups/jira
JIRA_BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# confluence-backup.sh
# ---------------------------------------------------------------------------
CONFLUENCE_SSH_TARGET=backup@confluence.example.com
CONFLUENCE_SSH_KEY=/root/.ssh/id_ed25519_backup
CONFLUENCE_APP_CONTAINER=confluence
CONFLUENCE_DB_CONTAINER=confluence-db
CONFLUENCE_DATA_PATH=/var/atlassian/application-data/confluence
CONFLUENCE_COMPOSE_DIR=/opt/confluence
CONFLUENCE_BACKUP_DIR=/srv/backups/confluence
CONFLUENCE_BACKUP_RETENTION_DAYS=14
