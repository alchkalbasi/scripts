# Target account
SCRIPT_USER=debian
REPO_NAME=debian
WORKSPACE_DIR="/home/${SCRIPT_USER}/workspace"
WORKSPACE_MODE=0755

# Debian repositories
DEBIAN_CODENAME="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"
APT_URL=https://deb.debian.org/debian
APT_SECURITY_URL=https://security.debian.org/debian-security
APT_COMPONENTS="main contrib non-free non-free-firmware"
APT_TARGET="/etc/apt/sources.list.d/${REPO_NAME}.list"
APT_RUN_UPGRADE=true
APT_INSTALL_RECOMMENDS=false
APT_ENABLE_BACKPORTS=true
APT_ENABLE_PROPOSED=false

PACKAGES_TO_INSTALL=(
    ca-certificates
    curl
    dnsutils
    git
    htop
    iptables
    openssh-server
    sudo
    vim
)
IPT_PERSISTENT=true

# Sudo and SSH
SUDOERS_FILE="/etc/sudoers.d/${SCRIPT_USER}"
SSH_DIR="/home/${SCRIPT_USER}/.ssh"
AUTH_KEYS="${SSH_DIR}/authorized_keys"
SSH_PUBLIC_KEYS=()
SSHD_CONFIG=/etc/ssh/sshd_config
BACKUP_SSHD=/etc/ssh/sshd_config.server-setup.bak
PORT=22
PERMIT_ROOT_LOGIN=no
MAX_AUTH_TRIES=3
PUBKEY_AUTH=yes
PASSWORD_AUTH=no
EMPTY_PASS=no
KBD_INTERACTIVE_AUTH=no
KERBEROS_AUTH=no
GSS_AUTH=no
USE_PAM=yes
X11_FORWARDING=no
PRINT_MOTD=no
ALLOW_SSH_LOCKOUT=false

# Firewall
IPTABLES_INPUT=DROP
IPTABLES_FORWARD=DROP
IPTABLES_OUTPUT=ACCEPT
IPTABLES_ALLOW_PORTS=(80 443)
IPTABLES_DOCKER_FORWARD=ACCEPT

# Docker repository
GPG_URL=https://download.docker.com/linux/debian/gpg
DOCKER_SOURCE_LIST_URL=https://download.docker.com/linux/debian
DOCKER_SOURCE_LIST_COMPONENT=stable
ARCH="$(dpkg --print-architecture)"

# Default prompt answers used by --non-interactive
STEP_APT_SOURCES_DEFAULT=Y
STEP_PACKAGES_DEFAULT=Y
STEP_PASSWORDLESS_SUDO_DEFAULT=N
STEP_SSH_KEYS_DEFAULT=Y
STEP_SSH_HARDENING_DEFAULT=Y
STEP_FIREWALL_DEFAULT=Y
STEP_DOCKER_DEFAULT=Y
STEP_DISABLE_IPV6_DEFAULT=N
STEP_WORKSPACE_DEFAULT=Y
